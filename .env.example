# Copy to .env only if you want to override the compose defaults. Nothing here
# is required -- `docker compose up` works with no .env at all.

# Postgres connection string. Compose sets this for you.
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable

# Shared secret for POST /admin/mint (test funding). Change it for any
# deployment you care about.
ADMIN_TOKEN=dev-admin-token

PORT=8080
LOG_LEVEL=info

# Connection pool. Keep DB_MAX_CONNS well under the database's max_connections,
# especially on a free tier where that ceiling is low.
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Lines of JSON log retained in memory and served at /logs.
LOG_RING_SIZE=5000

# How often the background sampler recomputes the conservation gauges.
INVARIANT_SAMPLE_SECONDS=15
